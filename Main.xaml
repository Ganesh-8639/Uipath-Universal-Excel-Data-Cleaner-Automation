      <ui:InvokeCode ContinueOnError="{x:Null}" Code="' ============================================================&#xA;' UNIVERSAL EXCEL CLEANER&#xA;' ============================================================&#xA;&#xA;' 1. Clean column headers&#xA;For Each col As DataColumn In dt.Columns&#xA;&#xA;    Dim header As String = col.ColumnName.Trim()&#xA;&#xA;    header = System.Text.RegularExpressions.Regex.Replace(&#xA;        header, &quot;\s+&quot;, &quot; &quot;)&#xA;&#xA;    col.ColumnName = header&#xA;&#xA;Next&#xA;&#xA;&#xA;' 2. Clean every cell&#xA;For Each row As DataRow In dt.Rows&#xA;&#xA;    For Each col As DataColumn In dt.Columns&#xA;&#xA;        If Not row.IsNull(col) Then&#xA;&#xA;            Dim value As String = row(col).ToString().Trim()&#xA;&#xA;            value = System.Text.RegularExpressions.Regex.Replace(&#xA;                value, &quot;\s+&quot;, &quot; &quot;)&#xA;&#xA;            row(col) = value&#xA;&#xA;        End If&#xA;&#xA;    Next&#xA;&#xA;Next&#xA;&#xA;&#xA;' 3. Remove rows containing ANY empty cell&#xA;Dim rowsToDelete As New List(Of DataRow)&#xA;&#xA;For Each row As DataRow In dt.Rows&#xA;&#xA;    Dim hasEmptyCell As Boolean = False&#xA;&#xA;    For Each col As DataColumn In dt.Columns&#xA;&#xA;        If row.IsNull(col) OrElse&#xA;           String.IsNullOrWhiteSpace(row(col).ToString()) Then&#xA;&#xA;            hasEmptyCell = True&#xA;            Exit For&#xA;&#xA;        End If&#xA;&#xA;    Next&#xA;&#xA;    If hasEmptyCell Then&#xA;        rowsToDelete.Add(row)&#xA;    End If&#xA;&#xA;Next&#xA;&#xA;&#xA;For Each row As DataRow In rowsToDelete&#xA;    dt.Rows.Remove(row)&#xA;Next&#xA;&#xA;dt.AcceptChanges()&#xA;&#xA;&#xA;' 4. Remove completely empty columns&#xA;Dim columnsToDelete As New List(Of DataColumn)&#xA;&#xA;For Each col As DataColumn In dt.Columns&#xA;&#xA;    Dim isEmptyColumn As Boolean = True&#xA;&#xA;    For Each row As DataRow In dt.Rows&#xA;&#xA;        If Not row.IsNull(col) AndAlso&#xA;           Not String.IsNullOrWhiteSpace(row(col).ToString()) Then&#xA;&#xA;            isEmptyColumn = False&#xA;            Exit For&#xA;&#xA;        End If&#xA;&#xA;    Next&#xA;&#xA;    If isEmptyColumn Then&#xA;        columnsToDelete.Add(col)&#xA;    End If&#xA;&#xA;Next&#xA;&#xA;&#xA;For Each col As DataColumn In columnsToDelete&#xA;    dt.Columns.Remove(col)&#xA;Next&#xA;&#xA;&#xA;' 5. Standardize common values&#xA;For Each row As DataRow In dt.Rows&#xA;&#xA;    For Each col As DataColumn In dt.Columns&#xA;&#xA;        If Not row.IsNull(col) Then&#xA;&#xA;            Dim value As String = row(col).ToString().Trim()&#xA;&#xA;            Select Case value.ToLower()&#xA;&#xA;                Case &quot;active&quot;&#xA;                    row(col) = &quot;Active&quot;&#xA;&#xA;                Case &quot;inactive&quot;&#xA;                    row(col) = &quot;Inactive&quot;&#xA;&#xA;                Case &quot;pending&quot;&#xA;                    row(col) = &quot;Pending&quot;&#xA;&#xA;                Case &quot;yes&quot;&#xA;                    row(col) = &quot;Yes&quot;&#xA;&#xA;                Case &quot;no&quot;&#xA;                    row(col) = &quot;No&quot;&#xA;&#xA;                Case &quot;true&quot;&#xA;                    row(col) = &quot;True&quot;&#xA;&#xA;                Case &quot;false&quot;&#xA;                    row(col) = &quot;False&quot;&#xA;&#xA;            End Select&#xA;&#xA;        End If&#xA;&#xA;    Next&#xA;&#xA;Next&#xA;&#xA;&#xA;' 6. Remove duplicate rows&#xA;If dt.Rows.Count &gt; 0 Then&#xA;&#xA;    Dim uniqueTable As DataTable =&#xA;        dt.DefaultView.ToTable(True)&#xA;&#xA;    dt.Clear()&#xA;&#xA;    For Each row As DataRow In uniqueTable.Rows&#xA;        dt.ImportRow(row)&#xA;    Next&#xA;&#xA;End If&#xA;&#xA;dt.AcceptChanges()" DisplayName="Invoke Code" sap:VirtualizedContainerService.HintSize="451.2,400.8" sap2010:WorkflowViewState.IdRef="InvokeCode_1">
